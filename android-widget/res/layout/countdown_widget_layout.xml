<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark / sleek layout that matches the in-app widget theme.
  RemoteViews only supports a limited set of view types; this layout uses
  LinearLayout + TextView only.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHIFTS UNTIL RETIREMENT"
        android:textColor="#A3A3A3"
        android:textSize="9sp"
        android:letterSpacing="0.25"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/widget_days_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DAYS"
        android:textColor="#D97736"
        android:textSize="9sp"
        android:letterSpacing="0.3"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_hms"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/widget_hms_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HOURS · MINUTES"
        android:textColor="#525252"
        android:textSize="8sp"
        android:letterSpacing="0.25"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
