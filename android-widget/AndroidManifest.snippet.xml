<!--
  Merge this <receiver> block INSIDE the <application> tag of:
    android/app/src/main/AndroidManifest.xml

  Place it next to your existing <activity android:name=".MainActivity" .../>,
  NOT inside it. Leave your existing entries untouched.

  Also add the string resource (next file).
-->
<receiver
    android:name=".CountdownWidgetProvider"
    android:exported="true"
    android:label="@string/widget_label">

    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>

    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/countdown_widget_info" />
</receiver>
